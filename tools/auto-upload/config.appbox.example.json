{
  "site": "https://seeduction.org",
  "apiKeyEnv": "SEEDUCTION_API_KEY",
  "stateFile": "./state.json",
  "intervalMinutes": 10,
  "maxPerRun": 5,
  "delaySeconds": 30,
  "description": "",

  "defaultCategory": "Films",
  "categoryRules": [
    { "match": "S\\d{2}E\\d{2}|\\bS\\d{2}\\b", "category": "Séries TV" },
    { "match": "FLAC|MP3|Discograph", "category": "Musique" }
  ],

  "sources": [
    {
      "name": "Appbox",
      "type": "qbittorrent",
      "url": "https://qbittorrent.oxyde.appboxes.co",
      "username": "${QBIT_USER}",
      "password": "${QBIT_PASS}",

      "qbitCategory": "a-publier",

      "ftp": {
        "host": "ftp.oxyde.appboxes.co",
        "port": 21,
        "username": "${FTP_USER}",
        "password": "${FTP_PASS}",
        "secure": true,
        "headMB": 16
      },
      "mediainfo": true,

      "seedOnSeeduction": true,
      "seedCategory": "seeduction"
    }
  ]
}
