{
  "site": "https://seeduction.org",
  "apiKeyEnv": "SEEDUCTION_API_KEY",
  "stateFile": "./state.json",
  "intervalMinutes": 15,
  "maxPerRun": 5,
  "delaySeconds": 30,
  "description": "Importé automatiquement depuis {source}",

  "defaultCategory": "Films",
  "categoryRules": [
    { "match": "S\d{2}E\d{2}|\bS\d{2}\b", "category": "Séries TV" }
  ],

  "sources": [
    {
      "name": "c411 (Torznab)",
      "type": "rss",
      "url": "https://c411.org/api?t=search&limit=50&apikey=${C411_API_KEY}",
      "nfo": "description",
      "exclude": ["\bCAM\b|\bTS\b"],
      "maxAgeHours": 48
    }
  ]
}
