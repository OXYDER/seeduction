SEEDUCTION_API_KEY=COLLE_ICI_LA_CLE_DE_TON_SITE
# Identifiant et mot de passe de l interface web de qBittorrent :
QBIT_USER=admin
QBIT_PASS=COLLE_ICI_LE_MOT_DE_PASSE_QBITTORRENT
