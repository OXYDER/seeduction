# Copie ce fichier en "cles.env" et remplis les valeurs (sans guillemets ni espaces). Ne le partage jamais (ignore par git).
# Cle API de ton site Seeduction (Profil > Developpeur, portees torrents:upload et torrents:read) :
SEEDUCTION_API_KEY=COLLE_ICI_LA_CLE_DE_TON_SITE
# Interface web de qBittorrent :
QBIT_USER=COLLE_ICI_L_IDENTIFIANT_QBITTORRENT
QBIT_PASS=COLLE_ICI_LE_MOT_DE_PASSE_QBITTORRENT
# Acces FTP de ton Appbox (Pure-FTPd), inutile si l'outil tourne en SSH sur la seedbox :
FTP_USER=COLLE_ICI_L_IDENTIFIANT_FTP
FTP_PASS=COLLE_ICI_LE_MOT_DE_PASSE_FTP
