// ===========================================================================
// SCHEMA PRISMA - MEGA TRACKER PRIVÉ
// ===========================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USERS & AUTH
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  UPLOADER
  MODERATOR
  SUPER_MODERATOR // modérateur avec droit de modifier les membres (upload, download, points, courriel...)
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  BANNED
  DISABLED
  PENDING_INVITE
  PENDING_EMAIL // inscription faite, courriel pas encore confirmé (code à 6 chiffres ou lien)
}

model User {
  id               String     @id @default(uuid())
  /// Les sessions ouvertes avant cette date ne sont plus valides (posée à chaque changement ou réinitialisation de mot de passe).
  sessionsValidAfter DateTime?
  /// Réinitialisation du mot de passe exigée par l'équipe : le compte reste inutilisable tant que le membre n'a pas choisi un nouveau mot de passe avec le lien reçu par courriel.
  mustResetPassword Boolean @default(false)
  username         String     @unique
  email            String     @unique
  passwordHash     String
  passkey          String     @unique @default(uuid()) // clé unique injectée dans l'URL announce
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)

  // 2FA
  twoFactorSecret  String?
  twoFactorEnabled Boolean    @default(false)
  twoFactorRecovery String[]  // codes de secours (hachés), à usage unique

  // Ratio / stats globales (dénormalisées pour perf, recalculées via les Announces)
  uploaded         BigInt     @default(0)
  downloaded       BigInt     @default(0)
  bonusPoints      Float      @default(0)
  /// Part de bonusPoints venue d'un don : elle se dépense normalement mais ne peut pas être misée dans Mise-O-jeu (toujours <= bonusPoints).
  donatedPoints    Float      @default(0)
  /// Le membre s'est retiré des jeux (Mise-O-jeu) : plus de paris ni de pronostics.
  gamesOptOut      Boolean    @default(false)

  // Parrainage
  invitedById      String?
  invitedBy        User?      @relation("Invites", fields: [invitedById], references: [id])
  invitees         User[]     @relation("Invites")
  inviteCodesOwned InviteCode[]

  // Relations
  torrentsUploaded Torrent[]  @relation("Uploader")
  favorites        Favorite[] @relation("UserFavorites")
  forumReads       ForumTopicRead[] @relation("ForumReads")
  forumFollows     ForumTopicFollow[] @relation("ForumFollows")
  torrentComments  TorrentComment[] @relation("CommentAuthor")
  torrentLikes     TorrentLike[]
  torrentRatings   TorrentRating[]
  entityFollows    EntityFollow[]
  peers            Peer[]
  snapshots        RatioSnapshot[]
  requests         TorrentRequest[]
  requestFills     TorrentRequest[] @relation("RequestFiller")
  forumPosts       ForumPost[]
  forumTopics      ForumTopic[]
  messagesSent     PrivateMessage[] @relation("Sender")
  messagesReceived PrivateMessage[] @relation("Recipient")
  reports          Report[]         @relation("Reporter")
  warnings         Warning[]
  bans             Ban[]
  activityLogs     ActivityLog[]
  announcements    Announcement[]
  descriptionTemplates DescriptionTemplate[]
  notifications    Notification[]
  collections      Collection[]           @relation("CollectionOwner")
  collectionItemsAdded CollectionItem[]    @relation("CollectionItemAdder")
  collectionCollaborations CollectionCollaborator[] @relation("CollectionCollaborator")
  badges           UserBadge[]
  apiKeys          ApiKey[]
  chatMessages     ChatMessage[]
  chatReactions    ChatReaction[]
  msgrConversationsCreated Conversation[]       @relation("ConversationCreator")
  msgrMemberships          ConversationMember[] @relation("ConversationMembers")
  msgrMessages             Message[]            @relation("MessagesSent")
  msgrReactions            MessageReaction[]
  supportTickets           SupportTicket[]        @relation("TicketRequester")
  supportAssigned          SupportTicket[]        @relation("TicketAssignee")
  supportMessages          SupportTicketMessage[]
  friendRequestsSent     Friendship[] @relation("FriendRequester")
  friendRequestsReceived Friendship[] @relation("FriendAddressee")

  minRatio         Float      @default(0.5) // ratio minimum requis pour continuer à download
  memberClass      MemberClass @default(NOUVEAU) // rang automatique (ancienneté, upload, ratio)
  freeleechTokens  Int        @default(0)
  avatarUrl        String?
  showAdult        Boolean    @default(false) // a activé l'affichage du contenu pour adultes (18+)
  presenceStatus   PresenceStatus @default(ONLINE) // préférence affichée quand le membre est connecté (voir enum)
  statusText       String?    @db.VarChar(100) // petit message libre affiché à côté du statut (profil, infobulle, chat)
  freeleechUntil   DateTime?  // freeleech personnel (cadeau de bienvenue, récompense...) : ses téléchargements ne comptent pas dans son ratio jusqu'à cette date
  // « En train de regarder X » via le lecteur desktop : rafraîchi toutes les quelques secondes tant que la lecture
  // continue (voir StreamController) — expire tout seul (watchingUntil) si le lecteur ferme sans prévenir, jamais
  // rempli pour du contenu adulte, et respecte showWatchingStatus (préférence du membre).
  watchingTitle      String?   @db.VarChar(140)
  watchingUntil      DateTime?
  showWatchingStatus Boolean   @default(true)
  // Affichage par défaut des listes de torrents (list | details | grid | posters | compact) — voir frontend/src/lib/viewMode.ts.
  defaultView      String     @default("grid") @db.VarChar(12)
  // Bulles de discussion sur le côté gauche du site (conversations publiques et privées) : vrai par défaut, désactivables dans le compte.
  chatBubbles      Boolean    @default(true)
  // Sirène quand le Canadien marque : désactivée par défaut, le membre l'active (le réglage suit son compte, sur tous ses appareils).
  goalSound        Boolean    @default(false)
  // Style des info-bulles de torrents au survol : poster | classic | cinema | minimal | off (voir frontend/src/lib/tipStyle.ts).
  tipStyle         String     @default("poster") @db.VarChar(10)
  dmPrivacy        DmPrivacy      @default(EVERYONE) // qui peut lui écrire en chat privé sans être son ami
  adultAcceptedAt  DateTime?
  signature        String?    @db.Text
  createdAt        DateTime   @default(now())
  lastSeenAt       DateTime?
  lastIp           String?

  // ---- Compte famille ----
  // Un profil est une ligne User rattachée au compte principal (parentId) : messagerie, amis, favoris, collections,
  // commentaires... sont ainsi propres à chaque profil sans rien changer ailleurs. Le ratio, l'upload, la passkey, le
  // mot de passe, la 2FA et les points restent ceux du compte principal. Le profil « principal » est le compte lui-même
  // (profileType MASTER). Le pseudo d'un profil est « <nom>·<pseudo du compte> » : le compte reste toujours visible.
  parentId         String?
  parent           User?      @relation("FamilyProfiles", fields: [parentId], references: [id])
  profiles         User[]     @relation("FamilyProfiles")
  profileName      String?    @db.VarChar(24)
  profileType      String     @default("MASTER") @db.VarChar(8) // MASTER | PROFILE (anciens profils : ADULT | CHILD)
  profilePerms     Json?      // droits accordés par le profil principal (voir common/utils/family-perms.ts)
  pinHash          String?    // PIN à 4 chiffres (haché) : demandé à chaque connexion et à chaque changement de profil
  pinFailures      Int        @default(0)
  pinLockedUntil   DateTime?
  profileBlocked   Boolean    @default(false) // profil bloqué par le profil principal
  familyEnabled    Boolean    @default(false) // sur le compte principal : le sélecteur de profils s'affiche à chaque connexion

  @@index([status])
  @@index([parentId])
  telegramLink     TelegramLink?
  savedSearches    SavedSearch[]
  pushSubscriptions PushSubscription[]
  chatBans         ChatBan[]  @relation("ChatBanned")
  requestsFound    TorrentRequest[] @relation("RequestFinder")
  // Préférences de notifications : { catégorie: false } coupe cette catégorie (tout est actif par défaut).
  notifPrefs       Json?
  // Dons : statut « donateur » (permanent une fois acquis), durée des avantages en cours, et réglages (voir DonationsService).
  donorSince       DateTime?
  donorUntil       DateTime?
  donorTotal       Float      @default(0)
  donorInvites     Int        @default(0)
  /// Parrainage : moment où celui qui a invité ce membre a reçu sa prime (et son montant ; 0 = aucune prime : code générique, même IP...).
  referralRewardedAt DateTime?
  /// Date de promotion automatique au rang « Uploadeur » (null : rang nommé à la main, jamais retiré automatiquement).
  autoUploaderAt   DateTime?
  /// Compte supprimé : le pseudo, les statistiques et les actions restent (le pseudo est réservé pour toujours), mais courriel, mot de passe, passkey, adresses IP et données privées sont effacés.
  deletedAt        DateTime?
  referralReward   Int        @default(0)
  hnrExemptUntil   DateTime?
  donorWall        Boolean    @default(false) // apparaître sur le mur des donateurs (opt-in)
  donations        Donation[]
  requestsProposed TorrentRequest[] @relation("RequestProposer")
  chatMutes        ChatMute[] @relation("ChatMuter")
  chatMutedBy      ChatMute[] @relation("ChatMuted")
  suggestions      Suggestion[]
  suggestionVotes  SuggestionVote[]
  suggestionComments SuggestionComment[]
  // Anti-triche (voir src/anticheat) : signaux détectés, dossier de suspicion, adresses vues à l'announce et flux par torrent.
  cheatEvents      CheatEvent[]
  cheatCase        CheatCase?
  userIps          UserIp[]
  torrentFlows     UserTorrentFlow[]
  subtitleFiles    SubtitleFile[]
}

// Journal « qui a fait quoi » des profils d'un compte famille, lu par le profil principal.
model FamilyActivity {
  id         String   @id @default(uuid())
  accountId  String
  profileId  String
  action     String   @db.VarChar(24)
  targetType String?  @db.VarChar(16)
  targetId   String?
  detail     String?  @db.VarChar(200)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([profileId, createdAt])
}

/// Journal de TOUTES les actions d'un membre (consultable par le staff sur son profil). Pas de relation : les lignes survivent à la suppression.
model MemberActivity {
  id         String   @id @default(uuid())
  accountId  String
  userId     String
  category   String   @db.VarChar(16)
  action     String   @db.VarChar(120)
  targetType String?  @db.VarChar(16)
  targetId   String?
  detail     String?  @db.VarChar(300)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, category, createdAt])
  @@index([createdAt])
}

model InviteCode {
  id         String    @id @default(uuid())
  code       String    @unique
  createdBy  User      @relation(fields: [createdById], references: [id])
  createdById String
  usedByEmail String?
  used       Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  // Codes « génériques » de l'administration (Admin > Invitations) : plusieurs inscriptions possibles, début programmé,
  // une seule inscription par adresse IP si demandé. Un code de membre garde les valeurs par défaut : 1 utilisation.
  label      String?   @db.VarChar(80)
  generic    Boolean   @default(false)
  maxUses    Int       @default(1)
  useCount   Int       @default(0)
  perIpOnce  Boolean   @default(false)
  disabled   Boolean   @default(false)
  startsAt   DateTime?
  uses       InviteUse[]
}

// Une ligne par inscription faite avec un code. ipKey n'est rempli que pour les codes limités à une inscription par IP :
// la contrainte d'unicité (inviteId, ipKey) l'impose même si deux inscriptions arrivent au même instant (NULL = pas de limite).
model InviteUse {
  id        String     @id @default(uuid())
  invite    InviteCode @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  inviteId  String
  userId    String
  ip        String?
  ipKey     String?
  createdAt DateTime   @default(now())

  @@unique([inviteId, ipKey])
  @@index([inviteId])
}

// ---------------------------------------------------------------------------
// TORRENTS
// ---------------------------------------------------------------------------

enum TorrentStatus {
  PENDING
  APPROVED
  REJECTED
  DEAD
}

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  slug     String     @unique
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children Category[] @relation("SubCategories")
  torrents Torrent[]
  requests TorrentRequest[]
  // Type de contenu (Film/Série/Musique/...) pour le générateur de description :
  // une sous-catégorie sans valeur hérite de celle de sa catégorie parente.
  contentKind TemplateKind?
  // Image affichée à la place de l'icône dans la barre des catégories (téléversée depuis l'administration).
  imageUrl    String?
  // Contenu pour adultes : masqué pour les membres qui n'ont pas activé l'option dans leur compte (les sous-catégories héritent).
  adult       Boolean    @default(false)
}

model Torrent {
  id             String        @id @default(uuid())
  infoHash       String        @unique // sha1 hex du dict "info" du .torrent
  name           String
  description    String?       @db.Text
  nfo            String?       @db.Text
  // Chemin public (ex: /api/covers/xxx.jpg) vers une pochette/affiche
  // téléchargée et sauvegardée sur Seeduction — jamais un lien direct vers un
  // service externe, pour ne pas dépendre de sa disponibilité.
  coverImage     String?
  // Fiche complète issue de la base externe choisie à l'upload (TMDB, Deezer...) :
  // durée, note, bande-annonce, titre original, etc. Les personnes/studios/genres
  // qui en découlent sont dans Entity/TorrentEntity, pour être navigables.
  metaSource     String?
  metaExternalId String?
  metadata       Json?
  filePath       String        // chemin de stockage du .torrent sur disque/S3
  size           BigInt
  fileList       Json          // liste des fichiers contenus [{path, size}]

  category       Category      @relation(fields: [categoryId], references: [id])
  categoryId     String

  uploader       User          @relation("Uploader", fields: [uploaderId], references: [id])
  uploaderId     String
  anonymousUpload Boolean      @default(false)

  status         TorrentStatus @default(PENDING)
  approvedAt     DateTime? // moment de l'approbation par le staff (sert au crédit d'envoi)
  // En attente de correction : le staff a mis le torrent en suspens et demande au membre de le corriger (le statut reste PENDING).
  holdAt         DateTime?
  holdReasons    String[]  @default([])
  holdNote       String?   @db.VarChar(600)
  holdByName     String?   @db.VarChar(60)
  // Le membre a corrigé et renvoyé le torrent en validation (message facultatif pour l'équipe).
  resubmittedAt  DateTime?
  resubmitNote   String?   @db.VarChar(400)
  // Dernier motif de rejet, affiché au membre dans « Mes envois ».
  rejectReason   String?   @db.VarChar(300)
  freeleech      Boolean       @default(false)
  doubleUpload   Boolean       @default(false)

  seeders        Int           @default(0)
  leechers       Int           @default(0)
  completedCount Int           @default(0) // nb total de "snatch" (téléchargement complet)
  streamCompletedCount Int     @default(0) // nb de lectures complètes via le lecteur Seeduction (pas de vrai téléchargement, à part)
  // Passage automatique à DEAD après un délai de grâce à 0 seeder (voir EconomyService.markDeadTorrents) : zeroSeedersSince
  // marque le début de la panne (remis à null dès qu'un seeder revient), diedAt le moment où le statut DEAD a été posé —
  // sert à calculer la récompense de reseed (TrackerService.grantReseedReward), proportionnelle au temps resté mort.
  zeroSeedersSince DateTime?
  diedAt           DateTime?
  // Récompense de reseed en attente de confirmation (voir TrackerService.confirmReseedReward / EconomyService) :
  // posée quand quelqu'un relance un torrent DEAD, confirmée seulement quand un AUTRE membre finit de le télécharger
  // (preuve que ça a vraiment servi) ou, à défaut, quand le releveur a tenu le seed assez longtemps tout seul.
  // Effacée sans récompense si le seed retombe à 0 avant l'une ou l'autre de ces conditions.
  revivedByUserId String?
  revivedAt       DateTime?

  peers          Peer[]
  entities       TorrentEntity[]
  favoritedBy    Favorite[]     @relation("TorrentFavorites")
  comments       TorrentComment[]
  likes          TorrentLike[]
  ratings        TorrentRating[]
  reseedRequestedAt DateTime?
  // Titres du film / de la série dans plusieurs langues et régions (une ligne par titre), pour retrouver un torrent quel que soit le titre cherché.
  searchTitles   String?       @db.Text
  releaseDate    String?       @db.VarChar(10) // date de SORTIE du contenu (film, épisode, saison, jeu...) : « AAAA-MM-JJ », « AAAA-MM » ou « AAAA » ; jamais la date de mise en ligne
  // Team de la release (clé normalisée du nom après le dernier tiret) : '' = aucune, vide = pas encore examiné (voir TeamsService).
  releaseGroup   String?       @db.VarChar(40)
  // Origine de production (Québec, France, Canada anglais, International) : un filtre, pas une catégorie.
  origin         String?
  // Date à laquelle le synopsis et le slogan affichés sur la fiche ont été traduits en français (vide = pas encore fait).
  overviewTranslatedAt DateTime?
  snatches       Snatch[]
  fixes          TorrentFix[]
  revivals       TorrentRevival[]
  playbackPositions PlaybackPosition[]
  chatShares     Message[]
  requestFilled  TorrentRequest?
  requestProposals TorrentRequest[] @relation("RequestProposedTorrent")
  collectionItems CollectionItem[]

  tags           String[]

  // Métadonnées techniques (facultatives — pertinentes selon la catégorie,
  // remplies à l'upload, utilisées par la recherche avancée).
  year            Int?
  language        String?
  resolution      String?
  codec           String?
  hdr             Boolean       @default(false)
  audio           String?
  source          String?
  containerFormat String?
  fps             Int?
  durationMinutes Int?

  // Film / série : saison et épisode (« Intégrale » / « Saison complète » pour un pack), genres, type de vidéo (2D, 3D FSBS, 3D, 3D HSBS).
  season          String?
  episode         String?
  genres          String[]
  // Langues des sous-titres (« FR », « EN », « FR forcés »...) lues dans le MediaInfo, le NFO ou le nom.
  subtitles       String[]      @default([])
  // Filtres propres à la catégorie ({ clé: [valeurs] }, voir common/utils/facet-schema.ts) ; null = pas encore analysé, {} = analysé sans rien trouver.
  attrs           Json?
  videoType       String?
  nfoFile         TorrentNfo?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([year])
  @@index([resolution])
  // Les listes (Parcourir, accueil) trient les torrents approuvés par date ou par seeders : sans ces index, la base trie tout le catalogue à chaque affichage.
  @@index([status, createdAt(sort: Desc)])
  @@index([status, seeders(sort: Desc)])
  @@index([uploaderId, createdAt(sort: Desc)])
  subtitleFiles   SubtitleFile[]
}

/// NFO joint à l'upload (stocké à part pour ne pas alourdir les listes de torrents).
model TorrentNfo {
  torrentId String  @id
  torrent   Torrent @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  content   String  @db.Text
}

// ---------------------------------------------------------------------------
// GÉNÉRATEUR DE DESCRIPTION
// ---------------------------------------------------------------------------

enum TemplateKind {
  FILM
  SERIE
  MUSIQUE
  JEU
  LOGICIEL
  LIVRE
  XXX
  DOCUMENT
  ARCHIVE
  PERSONNALISE
}

// Stocké en BBCode (format canonique) — Markdown/HTML/texte brut sont
// dérivés à la volée au moment de l'export, jamais persistés.
model DescriptionTemplate {
  id        String       @id @default(uuid())
  name      String
  kind      TemplateKind
  content   String       @db.Text
  isGlobal  Boolean      @default(false) // true = template admin partagé à tous
  owner     User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String?
  createdAt DateTime     @default(now())

  @@index([kind])
}

// ---------------------------------------------------------------------------
// TRACKER ENGINE (announce / scrape)
// ---------------------------------------------------------------------------

enum PeerEvent {
  STARTED
  STOPPED
  COMPLETED
  NONE
}

// Etat courant d'un peer pour un torrent donné (mis à jour à chaque announce)
model Peer {
  id            String    @id @default(uuid())
  torrent       Torrent   @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId     String
  user          User      @relation(fields: [userId], references: [id])
  userId        String

  peerId        String    // peer_id envoyé par le client BitTorrent
  userAgent     String?   @db.VarChar(120) // User-Agent du client à son dernier announce (anti-triche : cohérence avec le peer_id)
  ip            String
  port          Int

  uploaded      BigInt    @default(0) // cumulé pour CE torrent
  downloaded    BigInt    @default(0)
  left          BigInt    @default(0) // octets restants -> 0 = seeder

  isSeeder      Boolean   @default(false)
  lastEvent     PeerEvent @default(NONE)
  lastAnnounceAt DateTime @default(now())

  @@unique([torrentId, userId, peerId])
  @@index([torrentId, isSeeder])
  @@index([userId])
}

// Historique des cycles complets de téléchargement (pour stats + anti-cheat)
model Snatch {
  id         String   @id @default(uuid())
  torrent    Torrent  @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId  String
  userId     String
  completedAt DateTime @default(now())
  // Suivi du seed (règle « hit & run »)
  seedSeconds Int      @default(0)
  lastSeedAt  DateTime?
  satisfied   Boolean  @default(false) // temps de seed ou ratio sur ce torrent atteint
  hnr         Boolean  @default(false) // a arrêté de seeder trop tôt (avertissement envoyé)
  hnrClearedAt DateTime? // hit & run effacé avec des points bonus

  @@index([userId, torrentId])
  @@index([satisfied, hnr, completedAt])
}

// Dernière position de lecture connue dans le lecteur Seeduction (voir StreamService.pingWatching), pour proposer
// « Reprendre la lecture à xx:xx » à la place de « Ouvrir dans le lecteur » sur la fiche torrent. Privé au membre :
// n'a rien à voir avec le statut public « en train de regarder » (watchingTitle sur User). Par fichier (fileIndex),
// pas juste par torrent : un pack de plusieurs vidéos (épisodes, etc.) ne doit pas mélanger leurs positions.
/// Points bonus envoyés d'un membre à un autre (comptes principaux, jamais les profils d'un compte famille).
model PointTransfer {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  amount    Int
  message   String?  @db.VarChar(140)
  createdAt DateTime @default(now())

  @@index([fromId, createdAt])
  @@index([toId, createdAt])
}

model PlaybackPosition {
  id              String   @id @default(uuid())
  torrent         Torrent  @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId       String
  userId          String
  fileIndex       Int      @default(0)
  positionSeconds Int
  durationSeconds Int?
  updatedAt       DateTime @updatedAt

  @@unique([userId, torrentId, fileIndex])
}

// Snapshot périodique du ratio d'un user (pour graphiques d'évolution)
model RatioSnapshot {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  uploaded   BigInt
  downloaded BigInt
  takenAt    DateTime @default(now())

  @@index([userId, takenAt])
}

// ---------------------------------------------------------------------------
// REQUESTS (demandes de torrents par la communauté)
// ---------------------------------------------------------------------------

model TorrentRequest {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  bounty      Float    @default(0) // bonus points offerts (total, contributions des autres membres comprises)
  backers     Int      @default(1) // nombre de contributions à la récompense
  year        Int?
  language    String?  // langue souhaitée (VFQ, VFF, VOSTFR...)
  resolution  String?  // qualité souhaitée (1080p, 4K/2160p...)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?

  requestedBy User     @relation(fields: [requestedById], references: [id])
  requestedById String

  filledBy    User?    @relation("RequestFiller", fields: [filledById], references: [id])
  filledById  String?
  filledTorrent Torrent? @relation(fields: [filledTorrentId], references: [id], onDelete: SetNull)
  filledTorrentId String? @unique
  // « Trouvé par » : le membre qui a désigné un torrent déjà sur le site (il n'en est pas l'envoyeur) ; il reçoit une petite part de la récompense.
  finder      User?    @relation("RequestFinder", fields: [finderId], references: [id], onDelete: SetNull)
  finderId    String?
  finderPoints Float   @default(0)
  uploaderPoints Float @default(0)
  // Proposition en attente de la confirmation du demandeur (un torrent désigné par un autre membre que son envoyeur).
  proposedTorrent   Torrent? @relation("RequestProposedTorrent", fields: [proposedTorrentId], references: [id], onDelete: SetNull)
  proposedTorrentId String?
  proposedBy        User?    @relation("RequestProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  proposedById      String?
  proposedAt        DateTime?
  // Torrents refusés par le demandeur pour cette demande (ils ne peuvent plus être proposés).
  declinedTorrentIds String[] @default([])

  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// COMMUNAUTÉ : forums + messagerie privée
// ---------------------------------------------------------------------------

model ForumCategory {
  id       String         @id @default(uuid())
  name     String
  position Int            @default(0)
  parent   ForumCategory? @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children ForumCategory[] @relation("SubCategories")
  topics   ForumTopic[]
  // true = « catégorie » (simple regroupement de forums, sans sujets) ; false = « forum » (contient des sujets).
  isCategory Boolean       @default(false)
  description String?      @db.Text
  icon        String?      // emoji affiché devant le forum
  staffOnly   Boolean      @default(false) // visible et utilisable uniquement par le staff
  locked      Boolean      @default(false) // plus de nouveaux sujets (sauf staff)
  // Accès par rang : { read?: { type, minClass? }, write?: { type, minClass? } } avec type ALL | CLASS | UPLOADERS | DONORS | ADULT | STAFF (voir common/utils/forum-access.ts).
  // null = tout le monde. Se cumule avec staffOnly (lecture réservée au staff) et locked (écriture réservée au staff).
  access      Json?
  archived    Boolean      @default(false) // archive : lisible, mais plus rien n'y est publié (sauf staff)
  qa          Boolean      @default(false) // forum d'entraide : l'auteur d'un sujet (ou le staff) peut marquer la réponse qui règle le problème (« Résolu »)
  rules       String?      @db.Text        // consignes du forum, affichées en haut de sa page
}

model ForumTopic {
  id         String        @id @default(uuid())
  title      String
  category   ForumCategory @relation(fields: [categoryId], references: [id])
  categoryId String
  author     User          @relation(fields: [authorId], references: [id])
  authorId   String
  locked     Boolean       @default(false)
  sticky     Boolean       @default(false) // épinglé en haut de la liste
  viewCount  Int           @default(0)
  lastPostAt DateTime      @default(now())
  solvedPostId String?     // message choisi comme solution (forum d'entraide)
  posts      ForumPost[]
  reads      ForumTopicRead[]
  follows    ForumTopicFollow[]
  createdAt  DateTime      @default(now())

  @@index([categoryId, sticky, lastPostAt])
}

/// Sujet suivi par un membre : il est prévenu de chaque nouvelle réponse.
model ForumTopicFollow {
  user      User       @relation("ForumFollows", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId   String
  createdAt DateTime   @default(now())

  @@id([userId, topicId])
  @@index([topicId])
}

/// Dernier passage d'un membre dans un sujet : sert à repérer les sujets non lus.
model ForumTopicRead {
  user    User       @relation("ForumReads", fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId String
  readAt  DateTime   @default(now())

  @@id([userId, topicId])
}

model ForumPost {
  id        String     @id @default(uuid())
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId   String
  author    User       @relation(fields: [authorId], references: [id])
  authorId  String
  content   String     @db.Text
  createdAt DateTime   @default(now())
  editedAt  DateTime?

  @@index([topicId, createdAt])
}

model PrivateMessage {
  id          String   @id @default(uuid())
  sender      User     @relation("Sender", fields: [senderId], references: [id])
  senderId    String
  recipient   User     @relation("Recipient", fields: [recipientId], references: [id])
  recipientId String
  subject     String   @default("") // vide pour un message du chat privé (amis) — le formulaire de messagerie classique impose un sujet
  content     String   @db.Text
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  // Fil de discussion : tous les messages d'une conversation partagent le même threadId (vide = ancien message isolé).
  threadId    String?
  deletedBySender    Boolean @default(false)
  deletedByRecipient Boolean @default(false)

  @@index([threadId])
  @@index([recipientId, read])
}

// ---------------------------------------------------------------------------
// MODÉRATION
// ---------------------------------------------------------------------------

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id          String       @id @default(uuid())
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  reporterId  String
  targetType  String       // "torrent" | "user" | "forumPost" | "comment"
  targetId    String
  reason      String       @db.Text
  status      ReportStatus @default(OPEN)
  // Message de chat signalé : copie du texte au moment du signalement (l'auteur peut le supprimer ensuite), au format JSON.
  snapshot    String?      @db.Text
  createdAt   DateTime     @default(now())
}

model Warning {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  reason    String
  issuedBy  String
  createdAt DateTime @default(now())
}

model Ban {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  reason    String
  issuedBy  String
  expiresAt DateTime? // null = permanent
  createdAt DateTime  @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  summary   String?  @db.VarChar(300) // chapeau affiché dans les listes
  imageUrl  String?  // image principale (téléversée sur Seeduction : /api/covers/...)
  // Type de nouvelle (badge) : NEWS, UPDATE, EVENT, MAINTENANCE, IMPORTANT
  kind      String   @default("NEWS") @db.VarChar(12)
  commentsLocked Boolean @default(false)
  pinned    Boolean  @default(false)
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  AnnouncementComment[]
  reactions AnnouncementReaction[]
  views     AnnouncementView[]

  @@index([pinned, createdAt])
}

/// Commentaire sous une nouvelle (pas de relation vers User : l'auteur se retrouve par authorId).
model AnnouncementComment {
  id             String       @id @default(uuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  authorId       String
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  editedAt       DateTime?

  @@index([announcementId, createdAt])
}

/// Une réaction (émoji) par membre et par nouvelle.
model AnnouncementReaction {
  id             String       @id @default(uuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  userId         String
  emoji          String       @db.VarChar(8)
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
}

/// Qui a lu quelle nouvelle (un membre compte une fois).
model AnnouncementView {
  id             String       @id @default(uuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  userId         String
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String   // "LOGIN" | "UPLOAD" | "DELETE_TORRENT" | ...
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
}

enum NotificationType {
  FRIEND_REQUEST
  MESSAGE
  FORUM_REPLY
  REQUEST_FILLED
  TORRENT_APPROVED
  TORRENT_REJECTED
  ANNOUNCEMENT
  INVITE_USED
  BADGE_EARNED
  TORRENT_COMMENT
  SYSTEM
  FOLLOW
  RESEED_REQUEST
  SUPPORT
}

model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?          // route frontend à ouvrir au clic, ex: /forum/topics/xxx
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  // Onglet de la page Notifications (messages, forum, torrents, demandes, social, annonces, pot, support, système) : sert aussi aux préférences du membre.
  category  String           @default("system") @db.VarChar(20)
  // Regroupement : une notification non lue de même clé est mise à jour (« 5 nouvelles réponses ») au lieu d'en créer une nouvelle.
  groupKey  String?          @db.VarChar(120)
  count     Int              @default(1)

  @@index([userId, read])
  @@index([userId, category, read])
  @@index([userId, groupKey, read])
}

// ---------------------------------------------------------------------------
// COLLECTIONS
// ---------------------------------------------------------------------------

enum CollectionVisibility {
  PRIVATE       // visible et modifiable par le propriétaire uniquement
  PUBLIC        // visible par tous, modifiable par le propriétaire uniquement
  COLLABORATIVE // visible par tous, modifiable par le propriétaire + les collaborateurs
}

model Collection {
  id            String                   @id @default(uuid())
  name          String
  description   String?                  @db.Text
  visibility    CollectionVisibility     @default(PRIVATE)
  owner         User                     @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       String
  items         CollectionItem[]
  collaborators CollectionCollaborator[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([ownerId])
  @@index([visibility])
}

model CollectionItem {
  id           String     @id @default(uuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  torrent      Torrent    @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId    String
  addedBy      User       @relation("CollectionItemAdder", fields: [addedById], references: [id], onDelete: Cascade)
  addedById    String
  note         String?
  addedAt      DateTime   @default(now())

  @@unique([collectionId, torrentId])
}

model CollectionCollaborator {
  id           String     @id @default(uuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  user         User       @relation("CollectionCollaborator", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  addedAt      DateTime   @default(now())

  @@unique([collectionId, userId])
}

// ---------------------------------------------------------------------------
// BADGES & RÉPUTATION
// ---------------------------------------------------------------------------

// Le catalogue des badges (nom/icône/condition) est défini en code
// (common/utils/badges.ts), pas en base — seule l'obtention est persistée ici.
model UserBadge {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  code      String
  awardedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// API PUBLIQUE
// ---------------------------------------------------------------------------

// Seul le hash SHA-256 de la clé est stocké — la valeur en clair n'est
// affichée qu'une fois, à la création, jamais persistée ni récupérable.
model ApiKey {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  label      String
  keyHash    String    @unique
  keyPrefix  String    // affiché dans la liste pour identifier la clé sans exposer le secret
  scopes     String[]
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// AMIS
// ---------------------------------------------------------------------------

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// Une seule ligne par paire, quel que soit qui a envoyé la demande. ACCEPTED = amis. BLOCKED = requester a bloqué addressee.
model Friendship {
  id          String       @id @default(uuid())
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// ---------------------------------------------------------------------------
// CHAT EN DIRECT
// ---------------------------------------------------------------------------

// Chatroom globale unique (pas de canaux) — diffusion temps réel via
// ChatGateway (WebSocket), historique servi en REST pour le chargement initial.
model ChatMessage {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   String   @db.Text
  // Pièce jointe : soit une image (affichée en ligne), soit un fichier quelconque (lien de téléchargement) — jamais les deux.
  imageUrl  String?
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  createdAt DateTime @default(now())
  reactions ChatReaction[]

  @@index([createdAt])
}

// Une réaction (émoji) par membre et par message ; en choisir une nouvelle remplace la précédente (comme Messenger).
model ChatReaction {
  id        String      @id @default(uuid())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// Préférence d'affichage de présence, indépendante du fait d'être réellement connecté (calculée à part) :
// ONLINE/AWAY/BUSY s'affichent tel quel si le membre est connecté ; INVISIBLE l'affiche hors ligne pour les autres.
enum PresenceStatus {
  ONLINE
  AWAY
  BUSY
  INVISIBLE
}

// EVERYONE : n'importe quel membre peut écrire en chat privé, comme une « demande de message » Messenger, sans être ami.
// FRIENDS_ONLY : seuls les amis peuvent écrire ; un autre membre voit le bouton d'ajout en ami à la place du bouton Message.
enum DmPrivacy {
  EVERYONE
  FRIENDS_ONLY
}

// ---------------------------------------------------------------------------
// ENTITÉS INTERCONNECTÉES (acteurs, studios, genres, artistes, éditeurs...)
// ---------------------------------------------------------------------------

enum EntityType {
  PERSON   // acteurs, réalisateurs, producteurs, artistes, auteurs...
  COMPANY  // studios, labels, éditeurs, développeurs, chaînes
  GENRE
  PLATFORM
}

// Une même entité (ex : un acteur, un studio, un genre) est partagée par tous
// les torrents qui la référencent — cliquer dessus liste tous ces torrents.
model Entity {
  id         String          @id @default(uuid())
  type       EntityType
  name       String
  source     String          // tmdb | deezer | rawg | seeduction (nom normalisé)
  externalId String
  imageUrl   String?         // sauvegardée sur Seeduction, jamais un lien externe
  torrents   TorrentEntity[]
  followers  EntityFollow[]
  createdAt  DateTime        @default(now())

  @@unique([type, source, externalId])
  @@index([type, name])
}

model TorrentEntity {
  id        String  @id @default(uuid())
  torrent   Torrent @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId String
  entity    Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId  String
  role      String  // ACTOR | DIRECTOR | PRODUCER | WRITER | CREATOR | ARTIST | AUTHOR | STUDIO | LABEL | PUBLISHER | DEVELOPER | NETWORK | GENRE | PLATFORM
  detail    String? // ex : le personnage joué
  position  Int     @default(0)

  @@unique([torrentId, entityId, role])
  @@index([entityId, role])
}

// « À télécharger plus tard » : torrents mis de côté par un membre.
model Favorite {
  user      User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  torrent   Torrent  @relation("TorrentFavorites", fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId String
  createdAt DateTime @default(now())

  @@id([userId, torrentId])
  @@index([userId, createdAt])
}

// Commentaires sous un torrent.
model TorrentComment {
  id        String   @id @default(uuid())
  torrent   Torrent  @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId String
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  editedAt  DateTime?

  @@index([torrentId, createdAt])
}

enum MemberClass {
  NOUVEAU
  MEMBRE
  POWER_USER
  ELITE
  VETERAN
}

// Jeton freeleech dépensé sur un torrent : ses téléchargements ne comptent pas dans le ratio de ce membre.
model PersonalFreeleech {
  userId    String
  torrentId String
  expiresAt DateTime

  @@id([userId, torrentId])
  @@index([expiresAt])
}

// Réglages du site modifiables sans redéploiement (ex : freeleech global).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Import automatique de torrents depuis un qBittorrent (Admin > Import) : une source = un client qBittorrent (+ son accès FTP aux fichiers).
// `config` : réglages sans secret ; `secrets` : mots de passe qBittorrent / FTP, chiffrés (AES-256-GCM, clé dérivée de JWT_SECRET).
model ImportSource {
  id         String       @id @default(uuid())
  name       String
  enabled    Boolean      @default(false)
  uploaderId String // compte au nom duquel les torrents sont envoyés
  config     Json
  secrets    String       @default("")
  lastRunAt  DateTime?
  lastError  String?
  createdAt  DateTime     @default(now())
  items      ImportItem[]
}

// Mémoire de l'import : ce qui a déjà été traité (un torrent de qBittorrent n'est jamais envoyé deux fois).
model ImportItem {
  id        String       @id @default(uuid())
  source    ImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId  String
  key       String // identifiant du torrent chez qBittorrent (hash)
  name      String
  status    String // UPLOADED | DUPE | REJECTED | SKIPPED | REVIEW (à vérifier à la main) | READY (validé à la main, en attente d'envoi)
  why       String?
  detail    Json? // pour REVIEW / READY : ce qui a été détecté, les fiches suggérées et le choix fait à la main
  torrentId String?
  savePath  String?
  seeded    String? // null | OK | UNAVAILABLE : le torrent de Seeduction a-t-il été ajouté dans qBittorrent pour seeder
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([sourceId, key])
  @@index([sourceId, status])
}

// Connexion d'un MEMBRE à son propre client (qBittorrent + FTP facultatif) pour envoyer plusieurs torrents d'un coup (page « Envoyer »).
// Les mots de passe sont chiffrés (comme ceux de l'import staff) et ne sont jamais renvoyés au navigateur.
model MemberSeedbox {
  id         String             @id @default(uuid())
  userId     String             @unique
  config     Json
  secrets    String             @default("")
  lastScanAt DateTime?
  lastError  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  items      MemberImportItem[]
}

// Un torrent trouvé dans le client d'un membre : proposé (vert / orange), en file d'envoi, envoyé, déjà sur le site, refusé ou écarté.
model MemberImportItem {
  id        String        @id @default(uuid())
  box       MemberSeedbox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId     String
  key       String // identifiant du torrent chez qBittorrent (hash)
  name      String
  status    String // PROPOSED | DUPE | QUEUED | UPLOADED | REJECTED | IGNORED
  why       String?
  detail    Json? // ce qui a été détecté, les fiches suggérées, les corrections du membre
  nfo       String?       @db.Text
  torrentId String?
  savePath  String?
  seeded    String? // null | OK | UNAVAILABLE : la version Seeduction a-t-elle été ajoutée dans le client du membre
  learned   String? // null (pas encore jugé) | YES (accepté par la modération : le choix a gagné du poids) | NO (refusé, supprimé ou sans choix à retenir)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([boxId, key])
  @@index([boxId, status])
}

// Mémoire des choix du staff dans « À vérifier » : la prochaine release qui ressemble (même série, même film, même site pour une scène adulte)
// est rangée toute seule, avec la même catégorie et la même fiche, sans repasser par la vérification.
model ImportMemory {
  id           String   @id @default(uuid())
  key          String   @unique // T|serie|<titre> · T|film|<titre>|<année> · T|xxx|<titre>|<année> · S|<site> · N|<titre> (catégorie seule)
  label        String // libellé lisible (titre ou site)
  categoryId   String
  categoryName String
  metaKind     String?
  metaId       String?
  metaTitle    String?
  noMeta       Boolean  @default(false) // le staff a choisi « sans fiche »
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Choix des membres retenus au fil des acceptations : chaque release d'un membre ACCEPTÉE par la modération ajoute du poids au choix (catégorie + fiche)
// fait pour ce genre de release ; plus le poids est élevé, plus les releases qui ressemblent sont rangées toutes seules (voir import-memory.ts).
model MemberChoice {
  id              String   @id @default(uuid())
  key             String // même clé que ImportMemory (T|serie|<titre>, T|film|<titre>|<année>, S|<site>…)
  choiceHash      String // catégorie|type de fiche|fiche|sans fiche : un même choix s'additionne, des choix différents restent séparés
  label           String
  categoryId      String
  categoryName    String
  metaKind        String?
  metaId          String?
  metaTitle       String?
  noMeta          Boolean  @default(false)
  confirmations   Int      @default(0) // releases acceptées par la modération avec ce choix
  members         String[] // membres distincts qui l'ont fait (20 au plus)
  lastConfirmedAt DateTime @default(now())

  @@unique([key, choiceHash])
  @@index([key])
}

// Journal de l'import (derniers événements, purgé automatiquement).
model ImportEvent {
  id        String   @id @default(uuid())
  sourceId  String?
  level     String // INFO | WARN | ERROR
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Lien de réinitialisation de mot de passe émis par le staff (à usage unique, court).
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Confirmation par courriel (code à 6 chiffres ET lien) : inscription, changement de mot de passe, changement de courriel.
// Le code et le lien ne sont jamais stockés en clair ; `payload` garde la modification en attente (nouveau hash ou nouveau courriel).
model EmailChallenge {
  id        String    @id @default(uuid())
  userId    String
  purpose   String // SIGNUP | PASSWORD_CHANGE | EMAIL_CHANGE
  codeHash  String
  tokenHash String    @unique
  sentTo    String
  payload   Json?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

// « Merci » / « J'aime » sur un torrent (un par membre).
model TorrentLike {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  torrent   Torrent  @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId String
  createdAt DateTime @default(now())

  @@id([userId, torrentId])
  @@index([torrentId])
}

// Abonnement à un acteur, studio, genre, artiste... : notification à chaque nouveau torrent approuvé.
model EntityFollow {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId  String
  createdAt DateTime @default(now())

  @@id([userId, entityId])
  @@index([entityId])
}

// Événement freeleech programmé (dates de début et de fin, message affiché aux membres).
model FreeleechEvent {
  id          String   @id @default(uuid())
  title       String
  message     String?  @db.Text
  startsAt    DateTime
  endsAt      DateTime
  createdById String?
  createdAt   DateTime @default(now())

  @@index([startsAt, endsAt])
}

// Note de 1 à 5 étoiles donnée à un torrent (une par membre, modifiable).
model TorrentRating {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  torrent   Torrent  @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId String
  score     Int
  updatedAt DateTime @updatedAt

  @@id([userId, torrentId])
  @@index([torrentId])
}

// ---------------------------------------------------------------------------
// WIKI — remplace l'ancienne page « Règles » statique par une vraie base de
// connaissances éditable par le staff, avec recherche (voir wiki.service.ts).
// Peuplée automatiquement au premier démarrage (WikiService.onModuleInit,
// même idée que CategoriesService pour les catégories par défaut) puis tenue
// à jour manuellement (staff) ou par Claude à chaque nouvelle fonctionnalité.
// ---------------------------------------------------------------------------

model WikiCategory {
  id       String        @id @default(uuid())
  name     String
  slug     String        @unique
  icon     String?
  order    Int           @default(0)
  articles WikiArticle[]
}

model WikiArticle {
  id         String       @id @default(uuid())
  category   WikiCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  title      String
  slug       String       @unique
  content    String       @db.Text // BBCode, comme les nouvelles et le forum (voir lib/bbcode côté frontend)
  // Mots-clés/synonymes supplémentaires (pas forcément dans le titre ou le texte) pour que la recherche les trouve
  // quand même — ex. "hit and run", "HnR" en plus de "hit & run".
  keywords   String?
  // Apparaît aussi dans la FAQ (questions courtes, très consultées) en plus de sa catégorie normale.
  isFaq      Boolean      @default(false)
  order      Int          @default(0)
  // Empreinte du texte tel que le fichier de départ (wiki-seed.ts) l'a écrit : tant que l'article n'a pas été retouché par le
  // staff, un changement du fichier de départ le met à jour tout seul (voir WikiService.onModuleInit).
  seedHash   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// MESSENGER — un seul moteur de conversations pour le chat privé (1 à 1), les groupes et les canaux publics.
// Remplace à terme ChatMessage (chat public) et les PrivateMessage « dm-… » (chat privé) : leurs messages sont
// recopiés ici au démarrage (voir MessengerMigrationService, idempotent, sans rien supprimer des anciennes tables).
// ---------------------------------------------------------------------------

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum ConversationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  GIF
  SYSTEM
  BOT_ANSWER   // réponse de l'assistant du canal Support
  TICKET_OFFER // l'assistant propose de demander l'équipe ou d'ouvrir un billet de support
  HANDOFF      // l'assistant confirme avoir prévenu l'équipe et se retire
  POLL         // sondage : la question est le contenu, les choix et les votes sont dans Poll
}

model Conversation {
  id              String               @id @default(uuid())
  type            ConversationType
  // 1 à 1 : les deux ids triés (« a:b ») — garantit une seule conversation par paire, peu importe qui écrit le premier.
  directKey       String?              @unique
  name            String?              @db.VarChar(80)
  slug            String?              @unique // canaux
  description     String?              @db.VarChar(300)
  iconUrl         String?
  createdBy       User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById     String?
  // Canaux : rôle minimal pour lire / écrire (vide = tout le monde) — ex. un canal « Annonces » en lecture seule, ou « Staff ».
  readRole        UserRole?
  writeRole       UserRole?
  slowModeSeconds Int                  @default(0)
  pinnedMessageId String? // ancien épinglage (un seul message) : recopié dans ConversationPin au démarrage, plus utilisé
  // Message du jour d'un canal : affiché en haut du canal, avec la date de dernière modification (pour le ré-afficher à ceux qui l'avaient masqué).
  motd            String?              @db.VarChar(1000)
  motdAt          DateTime?
  pins            ConversationPin[]
  position        Int                  @default(0)
  archived        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lastMessageAt   DateTime             @default(now())
  members         ConversationMember[]
  messages        Message[]

  @@index([type, lastMessageAt])
}

model ConversationMember {
  id             String           @id @default(uuid())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User             @relation("ConversationMembers", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           ConversationRole @default(MEMBER)
  nickname       String?          @db.VarChar(40)
  // Tout ce qui est plus récent que ça (et pas écrit par soi) est « non lu » ; sert aussi aux « Vu » des autres membres.
  lastReadAt     DateTime         @default(now())
  mutedUntil     DateTime?
  pinned         Boolean          @default(false)
  archived       Boolean          @default(false)
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String            @id @default(uuid())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User              @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  type           MessageType       @default(TEXT)
  content        String            @default("") @db.Text
  replyTo        Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replyToId      String?
  replies        Message[]         @relation("MessageReplies")
  imageUrl       String?
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  mime           String?
  durationMs     Int?
  // Torrent partagé (la fiche s'affiche dans la bulle) — soit choisi explicitement, soit repéré dans un lien collé.
  torrent        Torrent?          @relation(fields: [torrentId], references: [id], onDelete: SetNull)
  torrentId      String?
  mentionIds     String[]
  editedAt       DateTime?
  // « Annuler l'envoi » : le contenu est effacé, la ligne reste pour garder le fil cohérent (réponses, « Vu »).
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  // Provenance des messages recopiés depuis les anciens chats (évite les doublons à chaque redémarrage).
  legacyChatId   String?           @unique
  legacyPmId     String?           @unique
  reactions      MessageReaction[]
  pins           ConversationPin[]
  poll           Poll?

  @@index([conversationId, createdAt])
  @@index([senderId])
  telegram       TelegramMessage?
}

// Une réaction (émoji) par membre et par message ; en choisir une nouvelle remplace la précédente.
// Messages épinglés d'une conversation (plusieurs, comme sur Discord et Telegram).
model ConversationPin {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId      String
  pinnedById     String?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, messageId])
  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// ---------------------------------------------------------------------------
// TEAMS : équipes de membres auxquelles on peut postuler (une seule team par compte).
// ---------------------------------------------------------------------------

model Team {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  tag          String?  @db.VarChar(8)
  description  String   @default("") @db.Text
  requirements String?  @db.Text // ce que la team attend d'un candidat
  logoUrl      String?
  leaderId     String?  // vide = team sans propriétaire (détectée automatiquement, en attente d'un vrai membre)
  auto         Boolean  @default(false) // ajoutée par le système d'après le nom des releases partagées
  releaseCount Int      @default(0) // releases partagées sous son nom
  recruiting   Boolean  @default(true)
  createdAt    DateTime @default(now())
  members      TeamMember[]
}

model TeamMember {
  id       String   @id @default(uuid())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  userId   String   @unique // un compte ne fait partie que d'une seule team
  role     String   @default("MEMBER") @db.VarChar(8) // LEADER | OFFICER | MEMBER
  joinedAt DateTime @default(now())

  @@index([teamId])
}

model TeamApplication {
  id          String    @id @default(uuid())
  teamId      String
  userId      String
  message     String    @db.Text
  proof       String?   @db.Text // preuve d'appartenance (obligatoire pour revendiquer une team sans propriétaire)
  status      String    @default("PENDING") @db.VarChar(10) // PENDING | ACCEPTED | DECLINED | WITHDRAWN
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?

  @@index([teamId, status])
  @@index([userId, status])
}


// ---------------------------------------------------------------------------
// SUPPORT — billets (tickets) liés au canal de chat « Support » (assistant IA + équipe) et au wiki.
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN     // en attente d'une réponse de l'équipe
  ANSWERED // l'équipe a répondu : en attente du membre
  RESOLVED // réglé (le membre peut encore répondre pour le rouvrir)
  CLOSED   // définitif
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketMessageKind {
  MEMBER // écrit par le membre
  STAFF  // écrit par l'équipe (`internal` = note privée, invisible du membre)
  EVENT  // changement de statut, d'assignation... (`internal` = visible du staff seulement)
  CHAT   // historique du chat de support joint à l'ouverture du billet
}

model SupportCategory {
  id          String   @id @default(uuid())
  name        String
  icon        String?  @db.VarChar(8)
  description String?  @db.VarChar(200)
  order       Int      @default(0)
  active      Boolean  @default(true)
  tickets     SupportTicket[]
}

model SupportTicket {
  id              String         @id @default(uuid())
  number          Int            @unique @default(autoincrement())
  subject         String         @db.VarChar(140)
  requester       User           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId     String
  category        SupportCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      String?
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  assignee        User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId      String?
  source          String         @default("WEB") @db.VarChar(8) // WEB | CHAT | STAFF
  // Qui doit lire la dernière réponse (pastille « nouveau »)
  unreadByRequester Boolean      @default(false)
  unreadByStaff     Boolean      @default(true)
  firstResponseAt DateTime?
  lastReplyAt     DateTime       @default(now())
  lastReplyBy     String         @default("MEMBER") @db.VarChar(8) // MEMBER | STAFF
  resolvedAt      DateTime?
  closedAt        DateTime?
  rating          Int?
  ratingComment   String?        @db.VarChar(500)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        SupportTicketMessage[]

  @@index([requesterId, status])
  @@index([status, lastReplyAt])
  @@index([assigneeId])
}

model SupportTicketMessage {
  id         String            @id @default(uuid())
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  kind       TicketMessageKind
  internal   Boolean           @default(false)
  content    String            @db.Text // BBCode (comme les commentaires et le forum)
  attachments Json?            // [{ url, name, kind: 'image' | 'file', size }]
  createdAt  DateTime          @default(now())

  @@index([ticketId, createdAt])
}

model SupportCanned {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(80)
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Activité de l'assistant du canal Support : limite de débit, nombre de tentatives avant de proposer un billet, statistiques.
model SupportChatEvent {
  id        String   @id @default(uuid())
  userId    String
  kind      String   @db.VarChar(12) // ANSWER | RESOLVED | NOT_SOLVED | OFFER | TICKET | HUMAN
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}


// Mémoire des torrents ressuscités (récompense de reseed versée) : héros de la page « Réanimation » et torrents revenus à la vie récemment.
model TorrentRevival {
  id        String   @id @default(uuid())
  torrent   Torrent  @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId String
  userId    String
  points    Int
  deadDays  Float    @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Pot commun (« Le Pot du Plaisir ») : les membres y versent des points bonus ; quand il est plein, un freeleech global (et d'autres récompenses) démarre.
// Un « cycle » est un remplissage : OPEN (on peut donner) -> FULL (plein, en attente du lancement) -> DONE (récompense lancée) ; le cycle suivant s'ouvre aussitôt.
model PotCycle {
  id             String        @id @default(uuid())
  number         Int
  goal           Int
  collected      Int           @default(0)
  status         String        @default("OPEN")
  startedAt      DateTime      @default(now())
  fullAt         DateTime?
  rewardStartsAt DateTime?
  rewardEndsAt   DateTime?
  rewardHours    Int?
  reached        Int[]         @default([]) // paliers (en % de l'objectif) déjà atteints dans ce cycle
  reachedDonors  Int[]         @default([]) // paliers de participation (nombre de donateurs) déjà atteints dans ce cycle
  donations      PotDonation[]

  @@index([status])
}

model PotDonation {
  id        String   @id @default(uuid())
  cycle     PotCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId   String
  userId    String
  amount    Int
  topUp     Boolean  @default(false) // mise de la maison (ajoutée par un administrateur, aucun point débité)
  createdAt DateTime @default(now())

  @@index([cycleId])
  @@index([userId, createdAt])
}

// Telegram : compte Seeduction relié à un compte Telegram (code à usage unique envoyé au robot). Sans ce lien, les messages
// du groupe Telegram ne sont pas recopiés dans Seeduction.
model TelegramLink {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique
  tgUserId   String   @unique
  tgUsername String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
}

// Correspondance entre un message Seeduction et le message Telegram qui lui répond / le reproduit (réponses, modifications, suppressions).
model TelegramMessage {
  id            String   @id @default(uuid())
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId     String   @unique
  tgChatId      String
  tgMessageId   Int
  // true : écrit sur Telegram par le membre lui-même (le robot ne peut pas le modifier, seulement le supprimer)
  fromTelegram  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([tgChatId, tgMessageId])
}

// Suggestions des membres (idées, améliorations, retours) : chaque membre propose, les autres votent ; plus une suggestion a de votes,
// plus elle monte dans la liste et plus elle a de chances d'être réalisée. Le staff la fait avancer (à l'étude, planifiée, en cours, réalisée...).
model Suggestion {
  id           String   @id @default(uuid())
  title        String   @db.VarChar(120)
  body         String   @db.Text
  // SITE | TORRENTS | CHAT | PLAYER | COMMUNITY | ECONOMY | OTHER
  category     String   @default("OTHER") @db.VarChar(16)
  // OPEN | REVIEW | PLANNED | PROGRESS | DONE | DECLINED | DUPLICATE
  status       String   @default("OPEN") @db.VarChar(12)
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String
  voteCount    Int      @default(0)
  commentCount Int      @default(0)
  // Réponse du staff affichée sous le titre (pourquoi refusée, ce qui est prévu...).
  statusNote   String?  @db.Text
  statusAt     DateTime?
  statusById   String?
  // Doublon : la suggestion qui la remplace (ses votes lui ont été transférés).
  duplicateOfId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  votes        SuggestionVote[]
  comments     SuggestionComment[]

  @@index([status, voteCount])
  @@index([authorId, createdAt])
}

model SuggestionVote {
  id           String     @id @default(uuid())
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  suggestionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime   @default(now())

  @@unique([suggestionId, userId])
  @@index([userId])
}

model SuggestionComment {
  id           String     @id @default(uuid())
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  suggestionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  content      String     @db.Text
  // Écrit par un membre de l'équipe (affiché avec un badge)
  staff        Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([suggestionId, createdAt])
}

// Bannissement du chat décidé par la modération : d'un canal public (conversationId) ou de tous les canaux publics (null), pour une durée ou à vie.
model ChatBan {
  id             String    @id @default(uuid())
  user           User      @relation("ChatBanned", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  conversationId String?
  reason         String    @db.VarChar(500)
  issuedById     String
  issuedByName   String    @db.VarChar(60)
  expiresAt      DateTime? // null = définitif
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([revokedAt, createdAt])
}

// Mise en sourdine d'un membre par un autre membre : ses messages n'apparaissent plus chez celui qui l'a mis en sourdine, pour une durée ou à vie.
model ChatMute {
  id        String    @id @default(uuid())
  user      User      @relation("ChatMuter", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  target    User      @relation("ChatMuted", fields: [targetId], references: [id], onDelete: Cascade)
  targetId  String
  expiresAt DateTime? // null = sans limite
  createdAt DateTime  @default(now())

  @@unique([userId, targetId])
  @@index([targetId])
}

// Don reçu, inscrit à la main par l'administration (les dons se font sur une plateforme externe : aucun paiement ne passe par le site).
model Donation {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  amount         Float
  currency       String   @default("CAD") @db.VarChar(6)
  note           String?  @db.VarChar(300)
  tierLabel      String?  @db.VarChar(60)
  // Avantages accordés par ce don (copie de ce qui a été versé).
  daysGranted    Int      @default(0)
  freeleechDays  Int      @default(0)
  hnrDays        Int      @default(0)
  pointsGranted  Int      @default(0)
  recordedById   String
  recordedByName String   @db.VarChar(60)
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([receivedAt])
  @@index([userId])
}

// Sondage posté dans une conversation : un message de type POLL (sa question) et ses choix ; un ou plusieurs votes par membre.
model Poll {
  id        String       @id @default(uuid())
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String       @unique
  question  String       @db.VarChar(200)
  multiple  Boolean      @default(false)
  closesAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id       String     @id @default(uuid())
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  text     String     @db.VarChar(80)
  position Int        @default(0)
  votes    PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(uuid())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId    String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId  String
  userId    String
  createdAt DateTime   @default(now())

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

// ---------------------------------------------------------------------------
// ANTI-TRICHE
// ---------------------------------------------------------------------------

/// Un signal suspect détecté sur un membre (announce, analyse horaire...). Les doublons proches sont fusionnés (count).
model CheatEvent {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  torrentId String?
  kind      String   @db.VarChar(32)
  points    Float
  count     Int      @default(1)
  details   Json?
  createdAt DateTime @default(now())
  lastAt    DateTime @default(now())

  @@index([userId, lastAt])
  @@index([kind, lastAt])
}

/// Dossier de suspicion d'un membre : score (avec décroissance), niveau, statut de traitement par l'équipe.
model CheatCase {
  id              String    @id @default(uuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String    @unique
  score           Float     @default(0)
  level           String    @default("NONE") @db.VarChar(10) // NONE | WATCH | SUSPECT | LIKELY | CRITICAL
  confidence      Int       @default(0) // 0-100
  status          String    @default("OPEN") @db.VarChar(10) // OPEN | REVIEWING | CLEARED | ACTIONED | EXPIRED
  breakdown       Json?     // par type de signal : points restants après décroissance, nombre, dernier
  families        String[]  // familles de signaux en jeu (ratio, client, network, bonus)
  alertedLevel    Int       @default(0)
  alertedAt       DateTime?
  clearedScore    Float?    // score au moment où le membre a été innocenté (pour ne rouvrir que sur de nouveaux indices)
  immuneUntil     DateTime?
  assigneeName    String?   @db.VarChar(40)
  reviewedByName  String?   @db.VarChar(40)
  resolvedAt      DateTime?
  firstFlaggedAt  DateTime  @default(now())
  lastEventAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  notes           CheatCaseNote[]

  @@index([status, score])
  @@index([level])
}

model CheatCaseNote {
  id         String    @id @default(uuid())
  case       CheatCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  authorName String    @db.VarChar(40)
  body       String    @db.VarChar(2000)
  kind       String    @default("NOTE") @db.VarChar(12) // NOTE | STATUS | ALERT
  createdAt  DateTime  @default(now())

  @@index([caseId, createdAt])
}

/// Adresses IP vues à l'announce pour chaque membre (détection de partage de passkey et de comptes multiples).
model UserIp {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  ip          String   @db.VarChar(64)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  announces   Int      @default(1)

  @@unique([userId, ip])
  @@index([ip])
  @@index([lastSeenAt])
}

/// Octets annoncés par un membre sur un torrent, par jour : sert à recouper ce que les uns envoient avec ce que les autres reçoivent.
model UserTorrentFlow {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  torrentId String
  day       DateTime @db.Date
  up        BigInt   @default(0)
  down      BigInt   @default(0)
  got       BigInt   @default(0) // octets réellement acquis d'après la baisse de « left » (≠ down si le client sous-déclare)
  announces Int      @default(0)

  @@unique([userId, torrentId, day])
  @@index([torrentId, day])
  @@index([day])
}

// ---------------------------------------------------------------------------
// MISE-O-JEU : paris et pronostics sur les matchs du Canadien (caisse commune : les gagnants se partagent les mises des participants)
// ---------------------------------------------------------------------------
model MojMatch {
  id         String    @id @default(uuid())
  nhlGameId  Int       @unique
  team       String    @db.VarChar(4)
  startUtc   DateTime
  kind       String    @db.VarChar(12)
  homeAbbrev String    @db.VarChar(4)
  awayAbbrev String    @db.VarChar(4)
  homeName   String    @db.VarChar(60)
  awayName   String    @db.VarChar(60)
  mineSide   String    @db.VarChar(4) // 'home' | 'away' : de quel côté joue notre équipe
  status     String    @default("OPEN") @db.VarChar(10) // OPEN | SETTLED | REFUNDED
  result     Json? // { mine, theirs, mode } une fois le match terminé
  settledAt  DateTime?
  createdAt  DateTime  @default(now())
  bets       MojBet[]

  @@index([status, startUtc])
}

model MojBet {
  id        String    @id @default(uuid())
  match     MojMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  userId    String
  market    String    @db.VarChar(8) // WIN | MODE | SCORE
  pick      String    @db.VarChar(12)
  stake     Int       @default(0) // 0 = pronostic gratuit
  payout    Int? // points reçus (mise remboursée comprise)
  status    String    @default("PENDING") @db.VarChar(10) // PENDING | WON | LOST | REFUNDED
  createdAt DateTime  @default(now())
  settledAt DateTime?

  @@unique([matchId, userId, market])
  @@index([userId, createdAt])
  @@index([matchId, market])
}

/// Points bonus offerts aux membres en ligne quand le Canadien marque (un seul versement par membre et par but).
model GoalReward {
  id        String   @id @default(uuid())
  userId    String
  gameId    Int
  goal      Int // numéro du but du Canadien dans ce match (1, 2, 3...)
  points    Int
  createdAt DateTime @default(now())

  @@unique([userId, gameId, goal])
  @@index([userId, createdAt])
  @@index([gameId])
}

/// Crédit d'envoi : à l'approbation d'un torrent, une part de sa taille est ajoutée à l'upload de son uploader, même si personne ne l'a encore téléchargé.
/// Une ligne par torrent (versé une seule fois). Sans lien vers Torrent pour survivre à sa suppression, qui reprend le crédit (revokedAt).
model UploadCredit {
  id          String    @id @default(uuid())
  torrentId   String    @unique
  userId      String // compte crédité
  torrentName String    @db.VarChar(300)
  bytes       BigInt
  percent     Int
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId, createdAt])
}

/// Machines à sous : une ligne par partie (tirage payant + tours gratuits éventuels). Sert à l'historique, aux limites de pertes et aux comptes de la maison.
model SlotSpin {
  id        String   @id @default(uuid())
  userId    String
  machine   String   @db.VarChar(12)
  stake     Int // mise débitée (0 pour le tour gratuit quotidien)
  valued    Int // mise sur laquelle les gains sont calculés (= stake, ou la mise fictive du tour gratuit)
  daily     Boolean  @default(false) // tour gratuit quotidien
  win       Int
  freeSpins Int      @default(0)
  rounds    Json // [{ stops: [a, b, c], mult, win, free }]
  jackpot   Boolean   @default(false) // gros lot progressif remporté
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// « Plus haut ou plus bas » : une partie (série de cartes). Une seule partie active par membre (clé `active`).
model HiLoGame {
  id        String    @id @default(uuid())
  userId    String
  stake     Int // mise débitée (0 pour la partie gratuite quotidienne)
  valued    Int // mise de référence des gains
  daily     Boolean   @default(false)
  status    String    @default("ACTIVE") @db.VarChar(8) // ACTIVE | CASHED | LOST | REFUNDED
  active    String?   @db.VarChar(1) // 'A' tant que la partie est active, sinon nul : garantit une seule partie active par membre
  step      Int       @default(0) // bonnes réponses de la série
  card      Int // carte visible, de 0 à 51
  multBp    Int       @default(10000) // multiplicateur cumulé en dix-millièmes (10 000 = ×1)
  payout    Int?
  history   Json // cartes vues et réponses : [{ card, guess?, won? }]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?

  @@unique([userId, active])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/// Gros lot progressif des machines à sous : une seule ligne (id « main »). Il grossit d'une petite part de chaque mise et repart de sa mise de départ quand il est remporté.
model SlotJackpot {
  id        String   @id
  pool      Float
  updatedAt DateTime @updatedAt
}

/// Remise de fidélité des machines à sous : une part des pertes nettes de la veille est rendue au membre (une seule fois par membre et par jour).
model SlotCashback {
  id        String   @id @default(uuid())
  userId    String
  day       String   @db.VarChar(10) // jour concerné (AAAA-MM-JJ, heure de Montréal)
  lost      Int // pertes nettes de ce jour
  amount    Int // points rendus
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([userId, createdAt])
}

/// Roue de la fortune : un tour gratuit par membre et par jour (heure de Montréal). Les récompenses sont des cadeaux du site, sans mise.
model WheelSpin {
  id          String   @id @default(uuid())
  userId      String
  day         String   @db.VarChar(10) // AAAA-MM-JJ, heure de Montréal
  segment     Int // secteur tiré (0 à 15)
  points      Int // points du secteur, série comprise
  tokens      Int // jetons freeleech gagnés
  streak      Int // jours de suite à ce tour
  streakBonus Int // bonus des 7 jours de suite
  createdAt   DateTime @default(now())

  @@unique([userId, day])
  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Banque de questions du quiz quotidien (la bonne réponse est `answer`, indice dans `choices`).
model QuizQuestion {
  id        String   @id @default(uuid())
  category  String   @db.VarChar(30)
  text      String   @db.VarChar(300)
  choices   String[]
  answer    Int
  explain   String?  @db.VarChar(300)
  active    Boolean  @default(true)
  asked     Int      @default(0) // fois où elle a été répondue
  right     Int      @default(0) // dont bonnes réponses
  createdAt DateTime @default(now())

  @@index([active])
}

/// Les questions d'un jour (les mêmes pour tous les membres), tirées à la première demande du jour.
model QuizDay {
  day         String   @id @db.VarChar(10) // AAAA-MM-JJ, heure de Montréal
  questionIds String[]
  createdAt   DateTime @default(now())
}

/// La partie d'un membre pour un jour : une seule par jour. Les réponses sont chronométrées par le serveur.
model QuizPlay {
  id          String    @id @default(uuid())
  userId      String
  day         String    @db.VarChar(10)
  questionIds String[]
  answers     Json      @default("[]")
  current     Int       @default(0) // indice de la question en cours
  startsAt    DateTime // début de la question en cours (le chrono part de là)
  status      String    @default("ACTIVE") @db.VarChar(10) // ACTIVE | DONE
  correct     Int       @default(0)
  points      Int       @default(0) // points des réponses (base + rapidité)
  bonus       Int       @default(0) // bonus sans-faute, série ou consolation
  streak      Int       @default(1)
  totalMs     Int       @default(0)
  podium      Int       @default(0) // rang au podium de la veille une fois payé (1 à 3)
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@unique([userId, day])
  @@index([day, status, correct])
  @@index([userId, createdAt])
}

/// Un match de la LNH ouvert aux pronostics gratuits (toutes les équipes de la ligue, pas seulement le Canadien).
model NhlGame {
  id         Int       @id // numéro du match dans l'API de la LNH
  day        String    @db.VarChar(10) // AAAA-MM-JJ (heure de l'Est)
  startUtc   DateTime
  kind       String    @db.VarChar(12)
  homeAbbrev String    @db.VarChar(4)
  awayAbbrev String    @db.VarChar(4)
  homeName   String    @db.VarChar(60)
  awayName   String    @db.VarChar(60)
  status     String    @default("OPEN") @db.VarChar(10) // OPEN | SETTLED | VOID
  homeScore  Int?
  awayScore  Int?
  outcome    String?   @db.VarChar(30)
  settledAt  DateTime?
  createdAt  DateTime  @default(now())
  picks      NhlPick[]

  @@index([day])
  @@index([status, startUtc])
}

/// Le pronostic d'un membre pour un match : le vainqueur choisi (H = domicile, A = visiteur). Modifiable jusqu'au début du match.
model NhlPick {
  id        String    @id @default(uuid())
  userId    String
  game      NhlGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    Int
  day       String    @db.VarChar(10)
  pick      String    @db.VarChar(1)
  status    String    @default("PENDING") @db.VarChar(10) // PENDING | WON | LOST | VOID
  points    Int       @default(0) // points versés (plafonds appliqués)
  streak    Int       @default(0) // bonnes prédictions de suite avant celle-ci
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settledAt DateTime?

  @@unique([userId, gameId])
  @@index([userId, day])
  @@index([day, status])
  @@index([userId, settledAt])
}

/// Bonus d'une journée parfaite (toutes les prédictions du jour gagnées) : une seule fois par membre et par jour.
model NhlDayBonus {
  id        String   @id @default(uuid())
  userId    String
  day       String   @db.VarChar(10)
  points    Int
  createdAt DateTime @default(now())

  @@unique([userId, day])
}

/// Prix hebdomadaire du podium des pronostics : un seul versement par semaine et par rang.
model NhlWeekPrize {
  id        String   @id @default(uuid())
  weekStart String   @db.VarChar(10) // lundi de la semaine concernée
  userId    String
  rank      Int
  points    Int
  wins      Int
  picks     Int
  createdAt DateTime @default(now())

  @@unique([weekStart, rank])
  @@unique([weekStart, userId])
}

/// Une partie de blackjack. L'état complet (cartes sorties du sabot, mains, croupier) est gardé côté serveur ; le croupier garde sa carte cachée jusqu'à la fin.
model BlackjackGame {
  id        String    @id @default(uuid())
  userId    String
  stake     Int // points débités au total (mise, doublements, séparation) ; 0 pour la partie gratuite quotidienne
  valued    Int // mise de base de la partie
  daily     Boolean   @default(false)
  status    String    @default("ACTIVE") @db.VarChar(8) // ACTIVE | DONE
  active    String?   @db.VarChar(1) // 'A' tant que la partie est active, sinon nul : garantit une seule partie active par membre
  state     Json
  version   Int       @default(0) // augmente à chaque coup : empêche deux coups simultanés de s'appliquer
  payout    Int?
  outcome   String?   @db.VarChar(10) // blackjack | win | push | lose | bust
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?

  @@unique([userId, active])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/// Un lancer de dés : deux dés, un pari sur le total ou sur des doubles. Le tirage, la mise et le gain sont réglés dans une seule étape côté serveur.
model DiceRoll {
  id        String   @id @default(uuid())
  userId    String
  stake     Int // points débités (0 pour le lancer gratuit quotidien)
  valued    Int // mise de référence des gains
  daily     Boolean  @default(false)
  kind      String   @db.VarChar(8) // UNDER | OVER | EXACT | DOUBLES
  n         Int // total visé (0 pour les doubles)
  d1        Int
  d2        Int
  mult      Int // cote en centièmes (570 = ×5,70)
  payout    Int // points rendus (mise comprise), 0 si perdu
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Cartes à collectionner : le portefeuille d'un membre (paquets à ouvrir, éclats issus des doublons, compteur de garantie légendaire).
model CardWallet {
  userId    String   @id
  packs     Int      @default(0)
  shards    Int      @default(0)
  pity      Int      @default(0) // paquets ouverts depuis la dernière carte légendaire
  opened    Int      @default(0) // paquets ouverts au total
  lastDaily String?  @db.VarChar(10) // dernier jour (heure de Montréal) où le paquet quotidien a été réclamé
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Une carte possédée par un membre (avec son nombre d'exemplaires). Le catalogue des cartes est dans le code (common/utils/cards.ts).
model UserCard {
  id        String   @id @default(uuid())
  userId    String
  cardId    String   @db.VarChar(40)
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
}

/// Paquet gagné en jouant (une seule fois par membre, source et clé : le même exploit ne rapporte jamais deux paquets).
model CardPackGrant {
  id        String   @id @default(uuid())
  userId    String
  source    String   @db.VarChar(12) // quiz | wheel | picks
  key       String   @db.VarChar(40)
  createdAt DateTime @default(now())

  @@unique([userId, source, key])
}

/// Points offerts une seule fois pour une série complétée (ou « album » pour la collection entière).
model CardSetReward {
  id        String   @id @default(uuid())
  userId    String
  setId     String   @db.VarChar(12)
  points    Int
  createdAt DateTime @default(now())

  @@unique([userId, setId])
}

/// Historique des paquets ouverts (cartes tirées et éclats gagnés).
model CardOpening {
  id        String   @id @default(uuid())
  userId    String
  cards     Json
  shards    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Progression d'un membre sur un défi (quotidien ou hebdomadaire). La récompense est versée une seule fois, au moment où le défi est réussi.
model ChallengeProgress {
  id        String    @id @default(uuid())
  userId    String
  scope     String    @db.VarChar(6) // daily | weekly
  period    String    @db.VarChar(10) // jour (AAAA-MM-JJ) ou lundi de la semaine
  cid       String    @db.VarChar(24) // identifiant du défi dans le catalogue (common/utils/challenges.ts)
  progress  Int       @default(0)
  done      Boolean   @default(false)
  points    Int       @default(0) // points versés pour ce défi
  packs     Int       @default(0)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, period, cid])
  @@index([userId, scope, period])
  @@index([doneAt])
}

/// Un jeu essayé par un membre un jour donné (activités gratuites seulement) : sert aux défis « jeux différents ».
model ChallengeActivity {
  id     String @id @default(uuid())
  userId String
  day    String @db.VarChar(10)
  game   String @db.VarChar(12)

  @@unique([userId, day, game])
  @@index([userId, day])
}

/// Bonus d'une période où les trois défis ont été réussis (une seule fois par membre et par période).
model ChallengeBonus {
  id        String   @id @default(uuid())
  userId    String
  scope     String   @db.VarChar(6)
  period    String   @db.VarChar(10)
  points    Int
  packs     Int
  createdAt DateTime @default(now())

  @@unique([userId, scope, period])
  @@index([userId, scope])
}

/// Journal central des points : créé et retiré, regroupé par membre, source et heure. Alimenté par un déclencheur PostgreSQL (installé au démarrage par
/// PointsLedgerService) qui note chaque changement de User.bonusPoints ; la source vient de l'étiquette posée par le jeu, sinon « autre ».
model PointsLedger {
  id     String   @id @default(uuid())
  userId String
  source String   @db.VarChar(16)
  hour   DateTime // début de l'heure (UTC)
  credit Float    @default(0)
  debit  Float    @default(0)
  count  Int      @default(0)

  @@unique([userId, source, hour])
  @@index([hour])
  @@index([userId, hour])
}

/// Question de quiz proposée par un membre, en attente de validation par le staff. Une fois acceptée, elle devient une QuizQuestion et le membre reçoit une petite récompense.
model QuizSuggestion {
  id         String    @id @default(uuid())
  userId     String
  category   String    @db.VarChar(30)
  text       String    @db.VarChar(300)
  choices    String[]
  answer     Int
  explain    String?   @db.VarChar(300)
  status     String    @default("PENDING") @db.VarChar(10) // PENDING | APPROVED | REJECTED
  note       String?   @db.VarChar(200) // raison du refus
  reward     Int       @default(0) // points versés à l'acceptation
  questionId String?
  reviewedBy String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Duel entre deux membres sur une activité gratuite (quiz, pronostics, défis). Rien n'est misé : le site offre une petite récompense à la fin.
model Duel {
  id           String    @id @default(uuid())
  challengerId String
  opponentId   String
  kind         String    @db.VarChar(12) // quiz | picks | challenges
  days         Int // durée en jours (3 ou 7)
  status       String    @default("PENDING") @db.VarChar(10) // PENDING | ACTIVE | DONE | DECLINED | CANCELED | EXPIRED
  startDay     String?   @db.VarChar(10)
  endDay       String?   @db.VarChar(10)
  scoreA       Int       @default(0) // score final du challenger
  scoreB       Int       @default(0) // score final de l'adversaire
  winnerId     String?
  pointsA      Int       @default(0) // points versés au challenger
  pointsB      Int       @default(0) // points versés à l'adversaire
  note         String    @default("") @db.VarChar(160)
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
  settledAt    DateTime?

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([status, endDay])
  @@index([settledAt])
}

/// Don reçu automatiquement d'une plateforme (Ko-fi, Buy Me a Coffee) : un message par paiement, jamais traité deux fois (provider + externalId uniques).
model DonationEvent {
  id          String   @id @default(uuid())
  provider    String   @db.VarChar(12)
  externalId  String   @db.VarChar(80)
  kind        String   @db.VarChar(16) // donation | subscription | other
  status      String   @default("PENDING") @db.VarChar(12) // CREDITED | PENDING | IGNORED | REFUNDED
  amount      Float
  currency    String   @db.VarChar(6)
  payerName   String   @default("") @db.VarChar(80)
  payerEmail  String   @default("") @db.VarChar(120) // masqué (ma***@gmail.com)
  message     String   @default("") @db.VarChar(400)
  suggestion  String?  @db.VarChar(40) // pseudo probable, à confirmer par l'équipe
  userId      String?
  donationId  String?
  note        String   @default("") @db.VarChar(200)
  createdAt   DateTime @default(now())

  @@unique([provider, externalId])
  @@index([status, createdAt])
}

/// Boîte courriel gérée dans l'interface Courriel du site (Purelymail, etc.) : accès IMAP pour lire, SMTP pour envoyer ; le mot de passe est chiffré (jamais renvoyé au navigateur).
model Mailbox {
  id             String   @id @default(uuid())
  label          String   @db.VarChar(60)
  imapHost       String   @db.VarChar(120)
  imapPort       Int      @default(993)
  imapSecure     Boolean  @default(true)
  smtpHost       String   @db.VarChar(120)
  smtpPort       Int      @default(465)
  smtpSecure     Boolean  @default(true)
  username       String   @db.VarChar(160)
  passwordSealed String   @db.Text
  /// Adresses (alias) qu'on peut choisir comme expéditeur : [{ address, name }]
  aliases        Json     @default("[]")
  signature      String   @default("") @db.VarChar(600)
  /// Administrateurs autorisés (le propriétaire a toujours accès à toutes les boîtes).
  allowedUserIds String[] @default([])
  /// L'administrateur qui a ajouté la boîte : il y a toujours accès et peut la régler (le rôle « propriétaire » du site peut tout régler).
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  templates      MailTemplate[]
}

/// Modèles de réponses du courriel : partagés par toutes les personnes qui ont accès à la boîte. Le corps est écrit en BBCode (comme l'éditeur du site) ; {{nom}} est remplacé par le nom du destinataire.
model MailTemplate {
  id          String   @id @default(uuid())
  mailboxId   String
  mailbox     Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(80)
  subject     String   @default("") @db.VarChar(200)
  body        String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mailboxId])
}

/// Alerte de recherche : les filtres de la page Parcourir (mêmes paramètres que l'adresse), vérifiés toutes les 5 minutes ; une alerte (cloche et/ou Telegram) part quand un nouveau torrent y correspond.
model SavedSearch {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  name          String    @db.VarChar(80)
  query         Json
  inApp         Boolean   @default(true)
  telegram      Boolean   @default(false)
  active        Boolean   @default(true)
  lastCheckedAt DateTime  @default(now())
  lastMatchAt   DateTime?
  matchCount    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([userId])
}

/// Sous-titres (.srt) partagés par les membres pour un torrent (ou un fichier précis d'un pack). Stockés en SRT UTF-8 ; le décalage de synchronisation est appliqué à la lecture.
model SubtitleFile {
  id         String   @id @default(uuid())
  torrent    Torrent  @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId  String
  /// Numéro du fichier dans le torrent ; vide = valable pour tout le torrent (film, épisode seul).
  fileIndex  Int?
  language   String   @db.VarChar(8)
  label      String   @default("") @db.VarChar(80)
  content    String   @db.Text
  cues       Int      @default(0)
  offsetMs   Int      @default(0)
  downloads  Int      @default(0)
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  uploaderId String?
  createdAt  DateTime @default(now())

  @@index([torrentId])
}

/// Historique du site : une ligne par heure (requêtes, erreurs 5xx, annonces du tracker, pic de membres en ligne, mémoire, retard maximal), conservée 120 jours. Sert aux graphiques d'Admin > Monitoring.
model SiteSample {
  hour       DateTime @id
  requests   Int      @default(0)
  errors     Int      @default(0)
  announces  Int      @default(0)
  onlinePeak Int      @default(0)
  rssMB      Int      @default(0)
  lagMs      Int      @default(0)
}

/// Incident de santé du site : de l'apparition d'un problème (contrôle en avertissement ou en erreur) à son rétablissement.
model HealthIncident {
  id         String    @id @default(uuid())
  checkId    String    @db.VarChar(40)
  label      String    @db.VarChar(120)
  level      String    @db.VarChar(8)
  detail     String    @default("") @db.VarChar(500)
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([startedAt])
  @@index([checkId, resolvedAt])
}

/// Appareil abonné aux notifications push (application installable) : une ligne par navigateur et par profil. Les messages sont chiffrés de bout en bout vers le navigateur (clés p256dh / auth).
model PushSubscription {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  endpoint   String    @unique @db.Text
  p256dh     String    @db.VarChar(160)
  auth       String    @db.VarChar(64)
  userAgent  String    @default("") @db.VarChar(200)
  createdAt  DateTime  @default(now())
  lastPushAt DateTime?
  failures   Int       @default(0)

  @@index([userId])
}

/// Points d'un membre au tournoi de la semaine (gratuit), par source : roue, quiz, pronostics, cartes, parties gratuites. La semaine va du lundi au dimanche (heure de Montréal) ; sa clé est le lundi.
model TournamentPoint {
  id        String   @id @default(uuid())
  weekKey   String   @db.VarChar(10)
  userId    String
  source    String   @db.VarChar(16)
  points    Int      @default(0)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([weekKey, userId, source])
  @@index([weekKey, userId])
}

/// Semaine de tournoi réglée (une seule fois) : prix versés et gros lot.
model TournamentWeek {
  weekKey      String   @id @db.VarChar(10)
  settledAt    DateTime @default(now())
  participants Int      @default(0)
  jackpot      Int      @default(0)
  results      Json
}

/// Correction proposée par un membre sur la fiche d'un torrent (langue, qualité, saison / épisode...) ou signalement d'un détail pas clair : l'équipe l'applique ou la refuse depuis la file de modération.
model TorrentFix {
  id           String    @id @default(uuid())
  torrent      Torrent   @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  torrentId    String
  authorId     String
  /// Valeurs proposées par champ (voir common/utils/torrent-fix.ts) ; vide = simple remarque.
  changes      Json      @default("{}")
  note         String?   @db.VarChar(500)
  status       String    @default("PENDING") @db.VarChar(10) // PENDING | ACCEPTED | REJECTED
  reviewedById String?
  reviewedByName String? @db.VarChar(60)
  reviewNote   String?   @db.VarChar(300)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([torrentId, status])
  @@index([authorId, createdAt])
}

/// Série suivie par un membre (compte principal) : « prévenez-moi dès que le prochain épisode sort ». L'état (prochain épisode, dernier sorti) est rafraîchi chaque jour depuis TMDB.
model SeriesFollow {
  id             String    @id @default(uuid())
  userId         String
  metaSource     String    @db.VarChar(16)
  metaExternalId String    @db.VarChar(40)
  title          String    @db.VarChar(200)
  cover          String?
  /// État TMDB : Returning Series, Ended, Canceled...
  status         String?   @db.VarChar(40)
  nextAirDate    String?   @db.VarChar(10)
  nextSeason     Int?
  nextEpisode    Int?
  nextName       String?   @db.VarChar(160)
  lastAirDate    String?   @db.VarChar(10)
  lastSeason     Int?
  lastEpisode    Int?
  /// Dernier épisode sorti au moment où on a commencé à suivre : seuls les épisodes à partir de celui-là déclenchent « disponible sur Seeduction ».
  baseSeason     Int?
  baseEpisode    Int?
  notifiedSoon   String?   @db.VarChar(12)
  notifiedAired  String?   @db.VarChar(12)
  checkedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, metaSource, metaExternalId])
  @@index([metaSource, metaExternalId])
  @@index([userId])
}
