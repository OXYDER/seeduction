# Base de données
# Ignoré par docker-compose (qui construit DATABASE_URL à partir du .env
# racine — voir .env.example) ; ne sert que si tu lances le backend hors
# Docker (npm run start:dev) contre un Postgres local.
DATABASE_URL="postgresql://tracker:changeme@localhost:5432/tracker?schema=public"

# Auth
JWT_SECRET="change-me-generate-a-long-random-string"

# Tracker
ANNOUNCE_BASE_URL="https://tracker.tondomaine.ca/tracker"
TORRENT_STORAGE_DIR="./storage/torrents"
COVER_STORAGE_DIR="./storage/covers"

# Recherche de métadonnées (pochettes/affiches) pour le générateur de
# description — gratuit. Musique (Deezer) et Livre (Google Books) marchent
# sans aucune clé. Film/Série (TMDB) ont besoin d'une clé gratuite créée sur
# https://www.themoviedb.org/settings/api — laisse vide pour désactiver
# uniquement la recherche Film/Série (le reste continue de fonctionner).
TMDB_API_KEY=""

# Optionnel : clé Google Books gratuite (console.cloud.google.com, API "Books").
# Sans clé, Google limite fortement les recherches anonymes (erreur 429) ; Seeduction
# bascule alors automatiquement sur Open Library pour les livres.
GOOGLE_BOOKS_API_KEY=""

# Optionnel : clé RAWG gratuite (https://rawg.io/apidocs) — active la recherche de jeux vidéo
# (fiche, développeurs, éditeurs, plateformes). RAWG demande de citer sa source (déjà fait
# sur la page du torrent). Sans clé, seule la recherche de jeux est désactivée.
RAWG_API_KEY=""

# Réseau
PORT=3000
CORS_ORIGIN="https://tracker.tondomaine.ca"

# Traduction automatique en français des synopsis fournis en anglais (optionnel).
# Par défaut MyMemory (gratuit, sans clé, quota journalier). MYMEMORY_EMAIL relève ce quota.
# GEMINI_API_KEY (palier gratuit) donne une meilleure traduction.
# MYMEMORY_EMAIL=
# GEMINI_API_KEY=

# Recherche XXX (ThePornDB) : jeton API d'un compte theporndb.net (optionnel).
# THEPORNDB_API_KEY=

# --- Économie de ratio (valeurs par défaut, toutes facultatives) ---
# HNR_SEED_HOURS=72          # heures de seed requises après un téléchargement complété
# HNR_RATIO=1                # ...ou ratio d'upload sur ce torrent qui dispense du temps de seed
# HNR_GRACE_HOURS=48         # délai avant qu'un abandon soit compté comme « hit & run »
# HNR_LIMIT=5                # hit & run non régularisés qui bloquent les nouveaux téléchargements
# RATIO_GRACE_GB=5           # volume téléchargé avant que le ratio minimum s'applique (nouveaux membres)
# BONUS_PER_TORRENT_HOUR=1   # points bonus par heure et par torrent seedé
# BONUS_MAX_TORRENTS=200     # plafond de torrents comptés par heure

# --- E-mails (facultatif) : active « Mot de passe oublié » par e-mail ---
# Sans SMTP_HOST, le staff génère les liens de réinitialisation à la main.
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Seeduction <no-reply@seeduction.org>"
# SITE_URL=https://seeduction.org
# --- Torrents morts : heures à 0 seeder avant passage automatique en DEAD ---
# DEAD_AFTER_HOURS=48

# --- Messenger : recherche de GIF et d'autocollants (Klipy, https://partner.klipy.com) ---
# Sans cette clé, l'onglet GIF ne propose que l'envoi depuis l'ordinateur.
# KLIPY_API_KEY=

# --- Appels audio/vidéo : serveurs STUN / TURN (facultatif) ---
# Sans rien, les appels utilisent le STUN public de Google (connexion directe entre les deux navigateurs).
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:seeduction.org:3478,turn:seeduction.org:3478?transport=tcp
# TURN_SECRET=la-même-valeur-que-TURN_SECRET-du-.env-racine

# --- Inscriptions limitées par adresse IP (codes d'invitation « une inscription par IP ») ---
# Nombre de proxys devant le backend qui ajoutent l'adresse de leur client : Nginx Proxy Manager + le nginx du site = 2 (défaut).
# Mets 3 si tu passes aussi par Cloudflare. Une valeur trop haute ou trop basse fausse l'IP retenue pour la limite.
# TRUSTED_PROXY_HOPS=2
