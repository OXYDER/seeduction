# Base de données
# Ignoré par docker-compose (qui construit DATABASE_URL à partir du .env
# racine — voir .env.example) ; ne sert que si tu lances le backend hors
# Docker (npm run start:dev) contre un Postgres local.
DATABASE_URL="postgresql://tracker:changeme@localhost:5432/tracker?schema=public"

# Auth
JWT_SECRET="change-me-generate-a-long-random-string"

# Tracker
ANNOUNCE_BASE_URL="https://tracker.tondomaine.ca/tracker"
TORRENT_STORAGE_DIR="./storage/torrents"

# Réseau
PORT=3000
CORS_ORIGIN="https://tracker.tondomaine.ca"

# Assistant IA (optionnel) — laisse les deux clés vides pour désactiver
# complètement (aucun coût, bouton caché). Limité à 10 suggestions/heure/membre
# côté serveur dans les deux cas.
#
# AI_PROVIDER choisit le fournisseur : "gemini" (gratuit, palier gratuit de
# Google — en contrepartie Google peut utiliser ce que tu envoies pour
# entraîner ses modèles) ou "claude" (payant, facturé sur ton compte
# Anthropic). Si tu ne fixes pas AI_PROVIDER, il est déduit automatiquement :
# gemini si GEMINI_API_KEY est renseignée, sinon claude.
# AI_PROVIDER="gemini"

# Option gratuite — clé créée sur https://aistudio.google.com
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-latest"

# Option payante (Claude)
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5"
