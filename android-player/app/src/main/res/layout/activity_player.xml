<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Chargement : affiche du titre en fond, titre, avancement de la mémoire tampon -->
    <FrameLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#06080F"
        android:clickable="true">

        <ImageView
            android:id="@+id/bgCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.30"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/loadBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="10dp"
            android:contentDescription="Retour"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="40dp">

            <TextView
                android:id="@+id/loadTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#F5F7FC"
                android:textSize="22sp" />

            <ProgressBar
                android:id="@+id/spinner"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                android:indeterminateTint="#E0B84A" />

            <ProgressBar
                android:id="@+id/loadBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="260dp"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progressTint="#E0B84A"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:maxWidth="420dp"
                android:text="Connexion à Seeduction…"
                android:textColor="#F5F7FC"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/loadingSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxWidth="460dp"
                android:textColor="#9BA3BA"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_gold"
                android:paddingHorizontal="26dp"
                android:paddingVertical="11dp"
                android:text="Fermer"
                android:textColor="#1C1404"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/bufferSpinner"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#E0B84A"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seekToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Commandes -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_fade_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="26dp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Retour"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="#C9D0E8"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/rewind"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:clickable="true">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="Reculer de 10 secondes"
                    android:src="@drawable/ic_replay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/playPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="28dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="Lecture ou pause"
                android:padding="20dp"
                android:src="@drawable/ic_pause"
                android:tint="#1C1404" />

            <FrameLayout
                android:id="@+id/forward"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:clickable="true">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="Avancer de 10 secondes"
                    android:src="@drawable/ic_forward" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_fade_bottom"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="30dp"
            android:paddingBottom="10dp">

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progressTint="#E0B84A"
                android:thumbTint="#F3D78A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/audio"
                    style="@style/PlayerChip">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_audio" />

                    <TextView
                        style="@style/PlayerChipText"
                        android:text="Audio" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/subs"
                    style="@style/PlayerChip">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_subtitles" />

                    <TextView
                        style="@style/PlayerChipText"
                        android:text="Sous-titres" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aspect"
                    style="@style/PlayerChip">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_aspect" />

                    <TextView
                        style="@style/PlayerChipText"
                        android:text="Format" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
